CAPSTONE_ENVIRONMENT=development
CAPSTONE_LOG_LEVEL=INFO
CAPSTONE_SERVICE_NAME=modern-data-engineering-ai
CAPSTONE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CAPSTONE_KAFKA_RAW_TOPIC=raw.events
CAPSTONE_KAFKA_VALIDATED_TOPIC=validated.events
CAPSTONE_KAFKA_QUARANTINE_TOPIC=quarantine.events
CAPSTONE_KAFKA_CONSUMER_GROUP=validation-consumer
CAPSTONE_DELTA_BASE_PATH=file:///opt/capstone/data/lakehouse
CAPSTONE_OPENSEARCH_URL=http://localhost:9200
CAPSTONE_OPENSEARCH_INDEX=knowledge-chunks
CAPSTONE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CAPSTONE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CAPSTONE_LLM_BASE_URL=http://localhost:11434
CAPSTONE_LLM_MODEL=qwen2.5:0.5b
# CAPSTONE_LLM_API_KEY is optional for the local Ollama service.
CAPSTONE_OPENLINEAGE_URL=http://localhost:5000
CAPSTONE_OPENLINEAGE_NAMESPACE=modern-data-engineering-ai
